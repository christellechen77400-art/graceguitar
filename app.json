{
  "expo": {
    "name": "GCCGuitare",
    "slug": "gccguitare",
    "scheme": "gccguitare",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5EFE3",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.renoo.gccguitare"
    },
    "android": {
      "package": "com.renoo.gccguitare"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-apple-authentication",
        {
          "usesAppleSignIn": true
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "GCCGuitare",
      "shortName": "GCCGuitare",
      "description": "Guitare de louange",
      "backgroundColor": "#F5EFE3",
      "themeColor": "#A85608",
      "display": "standalone",
      "orientation": "any"
    }
  }
}
